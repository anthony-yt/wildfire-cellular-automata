# ==============================================================================
# Configuración de Variables de Entorno - Wildfire Cellular Automata
# Copie este archivo como '.env' en la raíz del proyecto y complete con sus claves.
# ==============================================================================

# Clave de API de OpenWeatherMap (Plan estándar gratuito - 60 llamadas/min)
# Obtener en: https://home.openweathermap.org/api_keys
# Permite consultar clima actual y pronósticos a 5 días (intervalos de 3h).
OPENWEATHER_API_KEY=tu_openweather_api_key_aqui

# Clave de API de NASA FIRMS (MAP_KEY gratuita para focos de calor satelitales)
# Obtener en: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Permite consultar detecciones satelitales VIIRS / MODIS de incendios activos.
FIRMS_MAP_KEY=tu_nasa_firms_map_key_aqui
